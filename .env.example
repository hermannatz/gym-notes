# Neon Postgres connection string
DATABASE_URL=

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Clerk webhook signing secret (Svix). Required by /api/webhooks/clerk to
# verify incoming user.created / user.updated / user.deleted events.
CLERK_WEBHOOK_SIGNING_SECRET=

# Email: use Resend SMTP in production...
RESEND_API_KEY=

# ...or fall back to a local/custom SMTP server in development.
# Defaults to localhost:1025 when unset.
SMTP_HOST=
SMTP_PORT=

# Sender address for outgoing email
EMAIL_FROM=

# Add any additional provider keys (AI, payments, etc.) only when you
# introduce that feature.
